# Database (PostgreSQL)
DATABASE_URL=postgres://guidebook:guidebook@localhost:5432/guidebook

# Lanyard connection
LANYARD_URL=http://localhost:3000
LANYARD_SERVICE_KEY=sk_svc_your_key_here

# S3-Compatible Storage (for image uploads)
S3_ENDPOINT=http://localhost:9000
S3_REGION=auto
S3_BUCKET=lanyard
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
## Optional public URL for uploaded files (if your S3-compatible storage has a different public URL than the endpoint)
S3_PUBLIC_URL=

# Server
PORT=5000
NODE_ENV=development
